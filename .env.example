# E-Commerce Data Warehouse Environment Variables

# Database Configuration
# In docker-compose, this will connect to the local 'db' container if you run 'docker-compose up etl'
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=ecommerce_dw
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# AWS Configuration (Optional, required if using S3/KMS features in config.py)
AWS_REGION=us-east-1
S3_BUCKET_NAME=ecommerce-dw-data
KMS_KEY_ID=your-kms-key-id
